# Optional Compose project override. Keep this stable for GPU metrics collection.
COMPOSE_PROJECT_NAME=3dsg-heracles-benchmark

# Optional stable image name.
# BENCHMARK_IMAGE=3dsg-heracles-benchmark-main:latest

# The launcher sets these automatically; uncomment only when Docker uses a
# different host UID/GID mapping.
# HOST_UID=1000
# HOST_GID=1000
