ARG PYTORCH_VERSION=2.13.0
ARG CUDA_VERSION=13.0
ARG CUDNN_VERSION=9

# Build CUDA extensions and llama.cpp with the compiler toolchain, but do not
# carry that toolchain into the final image.
FROM pytorch/pytorch:${PYTORCH_VERSION}-cuda${CUDA_VERSION}-cudnn${CUDNN_VERSION}-devel AS builder

ARG LLAMA_CPP_REF=master

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HOME=/home/user
ENV WORKSPACE_DIR=/home/user/workspace
ENV PROJECT_DIR=/home/user/workspace/3dsg-cypher-agent
ENV MAIN_VENV=/home/user/workspace/.venv
ENV LLAMA_CPP_DIR=/home/user/workspace/llama.cpp
ENV LLAMA_CPP_PYTHON=/home/user/workspace/llama.cpp/.venv/bin/python

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        cmake \
        git \
        ninja-build \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p "${PROJECT_DIR}" \
    && git clone --depth 1 https://github.com/ggml-org/llama.cpp "${LLAMA_CPP_DIR}" \
    && cd "${LLAMA_CPP_DIR}" \
    && if [ "${LLAMA_CPP_REF}" != "master" ]; then \
        git fetch --depth 1 origin "${LLAMA_CPP_REF}" \
        && git checkout FETCH_HEAD; \
    fi \
    && python -m venv "${LLAMA_CPP_DIR}/.venv" \
    && "${LLAMA_CPP_PYTHON}" -m pip install --no-cache-dir --upgrade pip \
    && "${LLAMA_CPP_PYTHON}" -m pip install --no-cache-dir -r requirements.txt \
    && cmake \
        -S "${LLAMA_CPP_DIR}" \
        -B "${LLAMA_CPP_DIR}/build" \
        -G Ninja \
        -DBUILD_SHARED_LIBS=OFF \
    && cmake --build "${LLAMA_CPP_DIR}/build" --target llama-quantize \
    && cp "${LLAMA_CPP_DIR}/build/bin/llama-quantize" /tmp/llama-quantize \
    && rm -rf "${LLAMA_CPP_DIR}/build" "${LLAMA_CPP_DIR}/.git" \
    && mkdir -p "${LLAMA_CPP_DIR}/build/bin" \
    && mv /tmp/llama-quantize "${LLAMA_CPP_DIR}/build/bin/llama-quantize" \
    && ( "${LLAMA_CPP_DIR}/build/bin/llama-quantize" --help >/dev/null 2>&1; \
        status="$?"; [ "${status}" -eq 0 ] || [ "${status}" -eq 1 ] ) \
    && chmod -R a+rX "${LLAMA_CPP_DIR}"

WORKDIR ${PROJECT_DIR}

COPY pyproject.toml README.md ${PROJECT_DIR}/
COPY src ${PROJECT_DIR}/src
COPY scripts ${PROJECT_DIR}/scripts
COPY tests ${PROJECT_DIR}/tests
COPY configs ${PROJECT_DIR}/configs
COPY data/scenes ${PROJECT_DIR}/data/scenes

RUN python -m venv --system-site-packages "${MAIN_VENV}" \
    && "${MAIN_VENV}/bin/python" -m pip install --no-cache-dir --upgrade pip \
    && "${MAIN_VENV}/bin/python" -m pip install --no-cache-dir -e '.[train]' \
    && "${MAIN_VENV}/bin/python" -m pip install --no-cache-dir \
        "flash-linear-attention[cuda]==0.5.2" \
    && MAX_JOBS=2 "${MAIN_VENV}/bin/python" -m pip install \
        --no-cache-dir \
        --no-build-isolation \
        "causal-conv1d==1.7.0"


# The matching runtime image contains the CUDA/cuDNN libraries required by the
# compiled extension, without nvcc, CUDA headers, or the compiler toolchain.
FROM pytorch/pytorch:${PYTORCH_VERSION}-cuda${CUDA_VERSION}-cudnn${CUDNN_VERSION}-runtime AS runtime

ARG HOST_UID=1000
ARG HOST_GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HOME=/home/user
ENV WORKSPACE_DIR=/home/user/workspace
ENV PROJECT_DIR=/home/user/workspace/3dsg-cypher-agent
ENV MAIN_VENV=/home/user/workspace/.venv
ENV LLAMA_CPP_DIR=/home/user/workspace/llama.cpp
ENV LLAMA_CPP_PYTHON=/home/user/workspace/llama.cpp/.venv/bin/python
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        wget \
    && rm -rf /var/lib/apt/lists/*

# CUDA base images can already reserve UID/GID 1000, so adopt that account.
RUN set -eux; \
    existing_group="$(getent group "${HOST_GID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_group}" ] && [ "${existing_group}" != "user" ]; then \
        groupmod --new-name user "${existing_group}"; \
    elif [ -z "${existing_group}" ]; then \
        groupadd --gid "${HOST_GID}" user; \
    fi; \
    existing_user="$(getent passwd "${HOST_UID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "user" ]; then \
        usermod \
            --login user \
            --gid "${HOST_GID}" \
            --home /home/user \
            --move-home \
            --shell /bin/bash \
            "${existing_user}"; \
    elif [ -z "${existing_user}" ]; then \
        useradd \
            --uid "${HOST_UID}" \
            --gid "${HOST_GID}" \
            --create-home \
            --home-dir /home/user \
            --shell /bin/bash \
            user; \
    else \
        usermod \
            --gid "${HOST_GID}" \
            --home /home/user \
            --shell /bin/bash \
            user; \
    fi

RUN mkdir -p "${PROJECT_DIR}" /home/user/.cache/huggingface \
    && chown -R "${HOST_UID}:${HOST_GID}" /home/user

COPY --from=builder --chown=${HOST_UID}:${HOST_GID} \
    /home/user/workspace/.venv \
    /home/user/workspace/.venv
COPY --from=builder --chown=${HOST_UID}:${HOST_GID} \
    /home/user/workspace/llama.cpp \
    /home/user/workspace/llama.cpp
COPY --from=builder --chown=${HOST_UID}:${HOST_GID} \
    /home/user/workspace/3dsg-cypher-agent \
    /home/user/workspace/3dsg-cypher-agent

RUN printf '%s\n' \
        '' \
        '# Activate the project environment in interactive shells.' \
        'if [[ -f "${MAIN_VENV}/bin/activate" ]]; then' \
        '    export PATH="${PATH#${MAIN_VENV}/bin:}"' \
        '    unset VIRTUAL_ENV' \
        '    source "${MAIN_VENV}/bin/activate"' \
        'fi' \
        >> /home/user/.bashrc \
    && chown "${HOST_UID}:${HOST_GID}" /home/user/.bashrc

ENV VIRTUAL_ENV=${MAIN_VENV}
ENV PATH=${MAIN_VENV}/bin:${PATH}

WORKDIR ${PROJECT_DIR}

USER user:user

ENV USER=user
ENV NEO4J_URI=neo4j://neo4j:7683
ENV NEO4J_USERNAME=neo4j
ENV NEO4J_PASSWORD=neo4j_pw
ENV NEO4J_DATABASE=neo4j
ENV HERACLES_NEO4J_URI=neo4j://neo4j:7683
ENV HERACLES_NEO4J_USERNAME=neo4j
ENV HERACLES_NEO4J_PASSWORD=neo4j_pw
ENV ADT4_HERACLES_IP=neo4j
ENV ADT4_HERACLES_PORT=7683
ENV OLLAMA_HOST=http://ollama:11434

CMD ["bash"]
